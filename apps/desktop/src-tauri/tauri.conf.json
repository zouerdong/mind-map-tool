{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Map",
  "version": "0.1.0",
  "identifier": "com.mindmap.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mind Map",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' asset: tauri:; img-src 'self' asset: tauri: data: blob:; connect-src 'self' asset: tauri: blob: data: ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 ErDong Zou. MIT License.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      {
        "ext": ["mindmap"],
        "name": "Mind Map Document",
        "role": "Editor",
        "mimeType": "application/x-mindmap+json",
        "exportedType": {
          "identifier": "com.mindmap.document",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "1"
    }
  }
}
