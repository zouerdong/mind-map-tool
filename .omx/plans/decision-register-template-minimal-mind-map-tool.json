  "validationProfiles": {
    "spike-result": {
      "requires": [
        "G0.status=approved",
        "candidate results and evidence are internally consistent",
        "each recommendation references a PASS candidate with evidence",
        "all-failed tracks are blocked with recommended=null"
      ],
      "allows": ["G1.status=pending", "G2.status=pending"]
    },
    "bootstrap": {
      "inherits": "spike-result",
      "requires": [
        "top-level and all required tracks status=recommendation-ready",
        "G1.status=approved",
        "G1.sourceSpikeResult sha256 matches the immutable spike-result snapshot",
        "every G1 approvedTracks value matches a PASS recommendation and candidate evidence digest in that snapshot",
        "accepted ADR id/version/sha256 entries match approvedTracks and the current ADR bytes",
        "any recommendation, evidence, snapshot, or ADR drift after approval fails validation"
      ]
    },
    "packaging": {
      "inherits": "bootstrap",
      "requires": [
        "G2.status=approved for the exact selected host, candidate output paths, installation targets, allowed install/uninstall actions, and deletion boundaries"
      ],
      "doesNotAuthorize": [
        "signing",
        "notarization",
        "credential access",
        "upload",
        "publication"
      ]
    }
  },
