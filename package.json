{
  "name": "mind-map-tool",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "极简自由脑图桌面工具（macOS 优先；Tauri 2 + React/TypeScript）",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @mindmap/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --root .",
    "test:integration": "node scripts/quality/run-all.mjs --suite integration",
    "test:export": "node scripts/quality/run-export-golden.mjs",
    "test:visual": "node scripts/quality/run-visual-alignment.mjs",
    "test:a11y": "node scripts/quality/run-all.mjs --suite a11y",
    "test:e2e": "scripts/quality/run-e2e-macos.sh",
    "bundle:tauri": "node scripts/quality/bundle-gate.mjs --host tauri --scope-from docs/decisions/decision-register.json --candidate-root apps/desktop/src-tauri/target/release/bundle --inventory .tmp/release-candidate/bundle-inventory.json -- pnpm --filter @mindmap/desktop tauri build",
    "test:install:tauri": "node scripts/quality/install-gate.mjs --host tauri --scope-from docs/decisions/decision-register.json --candidate \"apps/desktop/src-tauri/target/release/bundle/macos/Mind Map.app\" --evidence-dir .tmp/release-candidate --plan",
    "quality": "node scripts/quality/run-all.mjs",
    "license:notices": "node scripts/quality/generate-third-party-notices.mjs",
    "license:scan": "node scripts/quality/scan-dependency-licenses.mjs",
    "net:scan": "node scripts/quality/scan-network-endpoints.mjs",
    "boundaries": "node scripts/quality/check-boundaries.mjs --scope selected-canvas",
    "icon:verify": "node scripts/quality/verify-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
